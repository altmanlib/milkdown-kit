{
  "name": "milkdown-kit-monorepo",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "bun run --filter @altmanlib/milkdown-kit build && bun run --filter @altmanlib/milkdown-kit-vue build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:docs": "bun scripts/check-docs.ts",
    "check:package": "bun run --filter './packages/*' check:package",
    "release": "bun run build && changeset publish",
    "check": "bun run typecheck && bun run test && bun run check:docs"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.2"
}
