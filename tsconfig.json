{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // Resolve workspace packages to their sources, so that typecheck and tests do not
    // depend on a previous build. Keep in sync with `alias` in vitest.config.ts.
    "paths": {
      "@altmanlib/milkdown-kit": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "packages/*/*.ts", "playground", "scripts", "*.ts"]
}
