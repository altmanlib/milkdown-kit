{
  "name": "@altmanlib/md-editor",
  "version": "0.0.0",
  "description": "Opinionated Markdown editor built on Milkdown Crepe, with a Vue component",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsdown && bun scripts/build-css.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:docs": "bun scripts/check-docs.ts",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.1",
    "@codemirror/language-data": "^6.3.1",
    "@floating-ui/dom": "^1.5.1",
    "@lezer/highlight": "^1.2.0",
    "@milkdown/crepe": "~7.22.1",
    "@milkdown/kit": "~7.22.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
